{
  "base": "origin/main",
  "carry": [
    "node_modules"
  ],
  "checks": [
    {
      "name": "build",
      "profile": "offline",
      "command": [
        "pnpm",
        "build"
      ]
    },
    {
      "name": "unit",
      "profile": "loopback",
      "command": [
        "pnpm",
        "test"
      ]
    },
    {
      "name": "perf",
      "profile": "offline",
      "command": [
        "pnpm",
        "test:perf"
      ]
    }
  ],
  "mutation": {
    "production": "^(?:packages/[^/]+/src/(?!.*__tests__/).*(?<!\\.d)\\.ts|scripts/gate/gate-lib\\.mjs)$",
    "command": [
      "pnpm",
      "exec",
      "stryker",
      "run",
      "${launcher}/stryker.config.json"
    ],
    "report": "reports/mutation/mutation.json",
    "profile": "loopback"
  },
  "guard": {
    "git": "(?:^|[|;&\\n(]|['\"])\\s*(?:\\S+=\\S*\\s+)*(?:(?:env|command|exec|sudo|time|nohup|xargs)\\s+(?:\\S+=\\S*\\s+)*)?git\\b",
    "push": [
      "${git}[^|;&\\n\"']*\\bpush\\b"
    ],
    "refuse": [
      {
        "pattern": "${git}[^|;&\\n\"']*\\bpush\\b[^|;&\\n\"']*\\s--no-veri[fy]*\\b",
        "why": "the command turns off the pre-push hook of the delivery gate (--no-verify)."
      },
      {
        "pattern": "\\s-c\\s*core\\.hookspath\\s*=|\\bconfig\\b[^|;&\\n]*\\bcore\\.hookspath\\s+[^\\s|;&]",
        "why": "the command moves git's hooks away from the pre-push hook of the delivery gate (core.hooksPath)."
      },
      {
        "pattern": "${git}[^|;&\\n\"']*\\b(?:send-pack|http-push)\\b",
        "why": "the command sends commits without git's pre-push hook."
      },
      {
        "pattern": "${git}[^|;&\\n\"']*\\bpush\\b[^|;&\\n\"']*(?:\\s--force(?:-with-lease|-if-includes)?\\b|\\s-[a-eg-z]*f[a-z]*(?=\\s|$)|\\s\\+[\\w./-]+(?=:|\\s|$)|\\s--mirror\\b)",
        "why": "a forced push is never used in this repository (docs/agent-guidance.md, CI contract, rule 3)."
      },
      {
        "pattern": "\\bgh\\s+pr\\s+merge\\b",
        "why": "no agent merges by hand in this repository: the review verdict decides the merge (docs/agent-guidance.md, CI contract, rule 1)."
      },
      {
        "pattern": "\\bgh\\s+api\\b(?=[^|;&\\n]*(?:/git/(?:refs|commits|trees|blobs)|/contents/|/pulls(?=\\s|$)|/merges?\\b))(?=[^|;&\\n]*\\s(?:-X\\s*|--method[\\s=]+)(?:POST|PUT|PATCH|DELETE)\\b)",
        "why": "the command writes to the repository through the API, where the delivery gate judges nothing. Commit, run the gate, and push with git."
      },
      {
        "pattern": "\\bgh\\s+api\\b(?=[^|;&\\n]*(?:/git/(?:refs|commits|trees|blobs)|/contents/|/pulls(?=\\s|$)|/merges?\\b))(?![^|;&\\n]*\\s(?:-X\\s*|--method[\\s=]+)GET\\b)(?=[^|;&\\n]*\\s(?:-f|-F|--field|--raw-field|--input))",
        "why": "the command writes to the repository through the API, where the delivery gate judges nothing. Commit, run the gate, and push with git."
      },
      {
        "pattern": "\\bgh\\s+api\\s+graphql\\b[^|;&\\n]*(?:createCommitOnBranch|createRef|updateRef|mergePullRequest|mergeBranch)",
        "why": "the command writes to the repository through the API, where the delivery gate judges nothing. Commit, run the gate, and push with git."
      },
      {
        "pattern": "\\bcurl\\b[^|;&\\n]*api\\.github\\.com",
        "why": "the command reaches the GitHub API outside the tools the delivery gate guards."
      }
    ],
    "refusedTools": [
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request_branch"
    ]
  }
}
