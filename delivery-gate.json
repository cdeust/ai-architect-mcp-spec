{
  "base": "origin/main",
  "checks": [
    { "name": "build", "profile": "offline", "command": "pnpm build" },
    { "name": "unit", "profile": "loopback", "command": "pnpm test" },
    { "name": "perf", "profile": "offline", "command": "pnpm test:perf" }
  ],
  "mutation": {
    "production": "^(?:packages/[^/]+/src/(?!.*__tests__/).*(?<!\\.d)\\.ts|scripts/gate/gate-lib\\.mjs)$",
    "command": "pnpm exec stryker run stryker.config.json",
    "report": "reports/mutation/mutation.json",
    "profile": "loopback"
  },
  "delivers": {
    "commands": ["\\bgit\\s+(?:-\\S+\\s+\\S+\\s+)*push\\b", "\\bgh\\s+pr\\s+create\\b"],
    "tools": ["mcp__github__create_pull_request", "mcp__github__push_files", "mcp__github__create_or_update_file"]
  }
}
