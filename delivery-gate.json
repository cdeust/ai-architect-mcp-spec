{
  "base": "origin/main",
  "checks": [
    {
      "name": "build",
      "profile": "offline",
      "command": [
        "pnpm",
        "build"
      ]
    },
    {
      "name": "unit",
      "profile": "loopback",
      "command": [
        "pnpm",
        "test"
      ]
    },
    {
      "name": "perf",
      "profile": "offline",
      "command": [
        "pnpm",
        "test:perf"
      ]
    }
  ],
  "mutation": {
    "production": "^(?:packages/[^/]+/src/(?!.*__tests__/).*(?<!\\.d)\\.ts|scripts/gate/gate-lib\\.mjs)$",
    "command": [
      "pnpm",
      "exec",
      "stryker",
      "run",
      "${launcher}/stryker.config.json"
    ],
    "report": "reports/mutation/mutation.json",
    "profile": "loopback"
  },
  "guard": {
    "push": [
      "\\bgit\\b[^|;&\\n]*\\bpush\\b",
      "\\bsend-pack\\b"
    ],
    "bypass": [
      "--no-verify\\b",
      "\\bcore\\.hooksPath\\b",
      "\\bsend-pack\\b",
      "\\bgh\\s+api\\b(?=[^|;&\\n]*(?:/git/(?:refs|commits|trees|blobs)|/contents/|/pulls(?=\\s|$)|/merges?\\b))(?=[^|;&\\n]*\\s(?:-X|--method|-f|-F|--field|--raw-field|--input)\\b)",
      "\\bcurl\\b[^|;&\\n]*api\\.github\\.com"
    ],
    "refusedTools": [
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request_branch"
    ]
  }
}
