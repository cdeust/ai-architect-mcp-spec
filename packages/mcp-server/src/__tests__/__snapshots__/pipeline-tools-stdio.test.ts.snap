          "prd_context": {
            "description": "The kind of PRD the request calls for, declared by the host, which has the whole conversation where the server has only feature_description. Omit it and the server reads the kind from the words of feature_description, or asks the user. get_prd_context_info gives the clarification range and the section count of a kind.",
            "enum": [
              "proposal",
              "feature",
              "bug",
              "incident",
              "poc",
              "mvp",
              "release",
              "cicd",
            ],
            "type": "string",
          },
          "request_size": {
            "description": "The size of the request, declared by the host: the server never reads a size from feature_description. 'tiny' (Tiny change) is the fast path for a small, self-contained change: 4 sections (overview, requirements, acceptance_criteria, testing) and 4 to 5 clarification rounds, in place of those of the kind. It is not for: incident, which keeps the rounds and sections of its kind. Declare prd_context with it: the exemption holds for a kind the run knows, and a kind read from the words of feature_description can miss an incident. Omit it for a request of ordinary size.",
            "enum": [
              "standard",
              "tiny",
            ],
            "type": "string",
          },
          "semantic_review": {
            "description": "Request one additional host judge for scope and declared edge-case coverage. Define requires a clear result for both checks.",
            "type": "boolean",
