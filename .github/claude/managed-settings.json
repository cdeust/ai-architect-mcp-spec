{
  "disableAllHooks": true,
  "allowManagedHooksOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Bash",
      "PowerShell",
      "Grep",
      "Glob",
      "LSP",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "RemoteTrigger",
      "SendMessage",
      "PushNotification",
      "CronCreate",
      "CronDelete",
      "ScheduleWakeup",
      "Skill",
      "EnterWorktree",
      "SendFeedback",
      "SendUserFile",
      "ShareOnboardingGuide",
      "Artifact",
      "Projects",
      "Workflow",
      "Monitor",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__github_ci",
      "mcp__github_file_ops",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//dev/**)",
      "Read(//etc/**)",
      "Read(//tmp/**)",
      "Read(//var/**)",
      "Read(//opt/**)",
      "Read(//home/runner/work/_*/**)",
      "Read(//run/**)",
      "Read(//root/**)",
      "Read(//srv/**)",
      "Read(//mnt/**)",
      "Read(//boot/**)",
      "Read(//snap/**)",
      "Read(//home/runner/runners/**)",
      "Read(//home/runner/actions-runner/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.config/**)",
      "Read(~/.local/**)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/**)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(~/.*)",
      "Read(~/.*/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.env*)",
      "Read(**/.git/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  }
}
