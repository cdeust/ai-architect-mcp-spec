{
  "disableAllHooks": true,
  "allowManagedHooksOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash",
      "Grep",
      "Glob",
      "LSP",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "RemoteTrigger",
      "SendMessage",
      "PushNotification",
      "CronCreate",
      "CronDelete",
      "ScheduleWakeup",
      "Skill",
      "EnterWorktree",
      "SendFeedback",
      "Artifact",
      "Projects",
      "Workflow",
      "Monitor",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__github_ci",
      "mcp__github_file_ops",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//dev/**)",
      "Read(//etc/**)",
      "Read(//tmp/**)",
      "Read(//var/**)",
      "Read(//opt/**)",
      "Read(//home/runner/runners/**)",
      "Read(//home/runner/actions-runner/**)",
      "Read(//home/runner/work/_temp/**)",
      "Read(//home/runner/work/_actions/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.config/**)",
      "Read(~/.local/**)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/**)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(**/.git/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  }
}
