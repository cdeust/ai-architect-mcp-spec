{
  "name": "ai-architect-mcp-spec",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "description": "Cross-platform PRD verifier and host-driven generator with deterministic structural rules, calibrated multi-judge verification, and full audit lineage. 16 MCP tools, 1903 tests.",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "bundle": "esbuild packages/mcp-server/dist/index.js --bundle --platform=node --target=node20 --format=esm --external:better-sqlite3 --outfile=mcp-server/index.js && node scripts/stamp-bundle-version.mjs && node -e \"require('node:fs').chmodSync('mcp-server/index.js',0o755)\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:portable": "node --test scripts/portable-distribution.test.mjs scripts/plugin-launcher.test.mjs",
    "test:portable:runtime": "node scripts/smoke-portable-hosts.mjs",
    "check:identity": "node scripts/check-distribution-identity.mjs",
    "check:docs": "node scripts/check-doc-claims.mjs",
    "test:watch": "vitest",
    "gate": "node scripts/gate/gate.mjs run",
    "gate:install": "node scripts/gate/gate.mjs install",
    "test:external-judge": "node --test scripts/external-judge/__tests__/*.test.mjs",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "clean": "pnpm -r clean && node scripts/clean.mjs mcp-server/index.js",
    "verify": "pnpm install --frozen-lockfile && pnpm build && pnpm bundle && pnpm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
